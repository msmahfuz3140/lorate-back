# ==============================================================================
# ROULETTE PREDICTION PLATFORM — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# 1. Never commit real credentials or production secrets to source control.
# 2. All values in this file are placeholders. Populate these in your hosting
#    provider environment variables (e.g. Render, Railway, Heroku, VPS).
# 3. Ensure this file is never exposed to public/client-side code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. Allowed CORS Origins
# Comma-separated list of permitted frontend origins (HTTPS in production)
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://roulette.tools,https://www.roulette.tools

# ------------------------------------------------------------------------------
# 3. Public Website URL & Backend API URL
# Separate URLs for frontend and backend production deployments
# ------------------------------------------------------------------------------
PUBLIC_WEBSITE_URL=https://roulette.tools
FRONTEND_URL=https://roulette.tools
BACKEND_URL=https://api.roulette.tools

# ------------------------------------------------------------------------------
# 4. Managed Database (MongoDB Atlas)
# Primary replica set URI with SSL/TLS and auth credentials
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-subdomain>.mongodb.net/roulette-platform?retryWrites=true&w=majority&appName=RouletteCluster

# ------------------------------------------------------------------------------
# 5. Authentication Secret & Token Lifecycle
# Cryptographically strong secrets (minimum 32 characters, e.g. openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_high_entropy_cryptographic_secret_min_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 6. Better Auth Configuration
# Better Auth server signing secret and public base URL
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace_with_better_auth_high_entropy_secret_min_32_chars
BETTER_AUTH_URL=https://api.roulette.tools

# ------------------------------------------------------------------------------
# 7. Designated Initial Main Admin Accounts
# Exactly 4 designated emails for initial bootstrap
# ------------------------------------------------------------------------------
MAIN_ADMIN_EMAILS=admin1@roulette.tools,admin2@roulette.tools,admin3@roulette.tools,admin4@roulette.tools

# ------------------------------------------------------------------------------
# 8. NOWPayments Gateway Integration
# Production API credentials from https://account.nowpayments.io/
# ------------------------------------------------------------------------------
NOWPAYMENTS_API_KEY=your_nowpayments_production_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# Payment Webhook Callback URL (Must be publicly accessible HTTPS endpoint)
NOWPAYMENTS_IPN_CALLBACK_URL=https://api.roulette.tools/api/v1/payments/ipn

# ------------------------------------------------------------------------------
# 9. Email Delivery Provider (Resend / SendGrid / Postmark)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=re_your_resend_production_api_key_here
EMAIL_FROM=Roulette.tools <security@roulette.tools>

# ------------------------------------------------------------------------------
# 10. SMS Delivery Provider (Twilio)
# ------------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=your_twilio_auth_token_here
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_FROM_NUMBER=+18005550199

# ------------------------------------------------------------------------------
# 11. Logging Configuration
# Levels: DEBUG | INFO | WARN | ERROR
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 12. Provider Credential Encryption (Dealer Signature SK key)
# Use a long random value. If omitted, JWT_SECRET is used as the key source.
# ------------------------------------------------------------------------------
DS_CONFIG_ENCRYPTION_KEY=replace_with_a_long_random_secret
